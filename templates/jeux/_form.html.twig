{{ form_start(form, {attr: {class: 'admin-form'}}) }}
    {{ form_errors(form) }}
    {{ form_row(form.titre) }}
    <div class="row">
        <div class="col-md-6">{{ form_row(form.genre) }}</div>
        <div class="col-md-6">{{ form_row(form.date_sortie) }}</div>
    </div>
    {{ form_row(form.description) }}
    {{ form_row(form.detail) }}
    {{ form_row(form.img) }}
    {{ form_row(form.galerieFichiers) }}
    {% if form.galerieASupprimer|length > 0 %}
        <div class="gallery-removal-field">
            {{ form_label(form.galerieASupprimer) }}
            {{ form_errors(form.galerieASupprimer) }}
            <div class="gallery-removal-grid">
                {% for imageField in form.galerieASupprimer %}
                    <label class="gallery-removal-option" for="{{ imageField.vars.id }}">
                        <img src="{{ asset('uploads/jeux/' ~ imageField.vars.value) }}" alt="Capture de {{ jeux.titre }}">
                        <span>{{ form_widget(imageField) }} Retirer cette photo</span>
                    </label>
                {% endfor %}
            </div>
        </div>
    {% endif %}
    {{ form_row(form.youtubeUrl) }}
    <button class="site-btn" type="submit">{{ button_label|default('Créer le jeu') }}</button>
{{ form_end(form) }}

