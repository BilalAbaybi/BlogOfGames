<form class="admin-delete-form" method="post" action="{{ path('app_plateforme_delete', {'id': plateforme.id}) }}" onsubmit="return confirm('Supprimer cette plateforme ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ plateforme.id) }}">
    <button class="admin-delete-button" type="submit">Supprimer</button>
</form>
