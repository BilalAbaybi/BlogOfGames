<form class="admin-delete-form" method="post" action="{{ path('app_genre_delete', {'id': genre.id}) }}" onsubmit="return confirm('Supprimer cette catégorie ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ genre.id) }}">
    <button class="admin-delete-button" type="submit">Supprimer</button>
</form>
